# Скопируйте в `.env.local` (не коммитьте реальные ключи).

# Подсказки Groq — https://console.groq.com/
VITE_GROQ_API_KEY=

# Картинки по PicSource / поиск по слову — https://pixabay.com/api/docs/
VITE_PIXABAY_API_KEY=

# Только для бэкапов с SOURCE=pexels — https://www.pexels.com/api/
# (запрос из браузера может блокироваться CORS; при ошибке сработает поиск Pixabay по слову)
VITE_PEXELS_API_KEY=
